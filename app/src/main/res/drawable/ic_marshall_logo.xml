<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Supercool MasterWave Brand Logo for Light Theme -->
    <group
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateX="8.1"
        android:translateY="8.1">

        <!-- Outer Ambient Frosted Disc -->
        <path
            android:pathData="M54,10 C78.3,10 98,29.7 98,54 C98,78.3 78.3,98 54,98 C29.7,98 10,78.3 10,54 C10,29.7 29.7,10 54,10 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="10"
                    android:startY="10"
                    android:endX="98"
                    android:endY="98"
                    android:type="linear">
                    <item android:color="#20165B33" android:offset="0.0" />
                    <item android:color="#08165B33" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Specular Highlight Bevel Ring -->
        <path
            android:strokeWidth="1.8"
            android:strokeColor="#35165B33"
            android:pathData="M54,14 C76.09,14 94,31.91 94,54 C94,76.09 76.09,94 54,94 C31.91,94 14,76.09 14,54 C14,31.91 31.91,14 54,14 Z" />

        <!-- MasterWave Dynamic M Crest (Left Wing) -->
        <path
            android:pathData="M26,68 L26,40 C26,36 30,33 34,36 L44,45 L44,72 L34,72 C29.58,72 26,68 26,68 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="26"
                    android:startY="33"
                    android:endX="44"
                    android:endY="72"
                    android:type="linear">
                    <item android:color="#165B33" android:offset="0.0" />
                    <item android:color="#0D3B20" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- MasterWave Dynamic M Crest (Center Pinnacle) -->
        <path
            android:pathData="M44,45 L54,26 C55.5,23.5 58.5,23.5 60,26 L70,45 L70,78 C70,81.5 67,84 63.5,84 L50.5,84 C47,84 44,81.5 44,78 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="44"
                    android:startY="24"
                    android:endX="70"
                    android:endY="84"
                    android:type="linear">
                    <item android:color="#00E676" android:offset="0.0" />
                    <item android:color="#165B33" android:offset="0.65" />
                    <item android:color="#0B2B17" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- MasterWave Dynamic M Crest (Right Wing) -->
        <path
            android:pathData="M70,45 L80,36 C84,33 88,36 88,40 L88,68 C88,72 84.42,72 80,72 L70,72 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="70"
                    android:startY="33"
                    android:endX="88"
                    android:endY="72"
                    android:type="linear">
                    <item android:color="#165B33" android:offset="0.0" />
                    <item android:color="#0D3B20" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Dynamic Soundwave Smile Arc -->
        <path
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:pathData="M38,54 Q54,66 70,54">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="38"
                    android:startY="54"
                    android:endX="70"
                    android:endY="54"
                    android:type="linear">
                    <item android:color="#00E676" android:offset="0.0" />
                    <item android:color="#FFFFFF" android:offset="0.5" />
                    <item android:color="#00E676" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
